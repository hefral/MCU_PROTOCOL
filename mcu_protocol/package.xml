<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mcu_protocol</name>
  <version>0.1.0</version>
  <description>
    STM32F103VET6 串口协议 V2 的 ROS 2 桥接驱动。

    分层刻意做得很清楚：protocol / parser / serial_port / link_state 四层不含任何
    ROS 头文件，可以在主机上用契约文档的参考帧做单元测试，一轮迭代几秒。CRC 参数、
    字节序、长度语义、重同步逻辑这些最容易写错又最难在现场定位的东西全在这一层。
    bridge_node 是唯一依赖 rclcpp 的文件。

    其他节点不该依赖本包 —— 只依赖 mcu_protocol_msgs 即可收发数据。
  </description>
  <maintainer email="hang@todo.invalid">hang</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>std_msgs</depend>
  <depend>mcu_protocol_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- mcu_monitor（调试用单屏监视节点）需要。只在运行期依赖，驱动本身不含 Python。 -->
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
